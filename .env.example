# Copie este archivo como .env y complete sus claves. El archivo .env NUNCA se sube al repositorio.

# Chat del agente (modelos gratuitos). Se crea en https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...
# Opcional: solo si el juez es Gemini (JUEZ_PROVIDER=google). Se crea en https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...

# Modelos (cámbielos aquí si el proveedor retira alguno)
LLM_MODEL=nvidia/nemotron-3.5-super-vl:free
# Juez: modelo de OTRA empresa que el agente (google = Gemini, si su clave tiene nivel gratuito)
JUEZ_PROVIDER=openrouter
JUEZ_MODEL=recursive/flint-v1.0:free
# Límite de tokens por respuesta (el razonamiento de modelos como Nemotron cuenta dentro) y esfuerzo de razonamiento
# LLM_MAX_TOKENS=4000
# LLM_REASONING_EFFORT=low

# Persistencia: local = SQLite + Chroma (venv y Colab) | postgres = PostgreSQL + pgvector.
# Con Docker no hace falta tocarla: docker-compose.yml fija PERSISTENCIA=postgres y DATABASE_URL.
PERSISTENCIA=local
# Solo si usa PostgreSQL fuera de Docker (por ejemplo, la base de Docker desde su computador):
# DATABASE_URL=postgresql://curacavi:curacavi@localhost:5433/curacavi

# openrouter = usa el LLM | offline = sin LLM (respuestas con plantillas, plan B de la demo)
LLM_PROVIDER=openrouter
# local = MiniLM en su computador | offline = sin descargas (solo pruebas)
EMBEDDINGS_PROVIDER=local

# Opcional: fija la fecha "de hoy" del agente para una demo reproducible (AAAA-MM-DD)
# FECHA_REFERENCIA=2026-11-04
# Opcional: true = los escalamientos esperan aprobación de un funcionario
APROBACION_HUMANA=true

# Opcional: trazas de cada ejecución del grafo en LangSmith (https://smith.langchain.com → Settings → API Keys)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=agente-tramites-curacavi
